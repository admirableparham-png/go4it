# Copy this file to .env and fill in what you need.
#   cp .env.example .env

# --- Telegram alerts (optional but recommended) ---
# 1. Create a bot with @BotFather -> get the token.
# 2. Add the bot to your team group, send a message, then read the chat id
#    from  https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Matching sensitivity (0-100) ---
# A demand/offer pair scoring at or above this becomes a match. Lower = more
# (looser) matches, higher = only tight matches. 60 is a good starting point.
MATCH_THRESHOLD=60

# --- Database ---
# Default is a local SQLite file. Switch to Postgres later with one line:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/go4it
DATABASE_URL=sqlite:///data.db
