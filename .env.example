# Copy this file to .env and fill in what you need.
#   cp .env.example .env

# --- Telegram alerts (optional but recommended) ---
# 1. Create a bot with @BotFather -> get the token.
# 2. Add the bot to your team group, send a message, then read the chat id
#    from  https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Matching sensitivity (0-100) ---
# A demand/offer pair scoring at or above this becomes a match. Lower = more
# (looser) matches, higher = only tight matches. 60 is a good starting point.
MATCH_THRESHOLD=60

# --- Database ---
# Default is a local SQLite file. Switch to Postgres later with one line:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/go4it
DATABASE_URL=sqlite:///data.db

# --- go4worldbusiness portal scraper (browser bot) ---
# Your OWN paid-account login. Leave blank to disable the portal source.
# WARNING: automated access may violate go4worldbusiness Terms and can risk your
# paid account. You chose this; keep the cadence gentle (hourly).
GO4WORLD_EMAIL=
GO4WORLD_PASSWORD=
GO4WORLD_LOGIN_URL=https://www.go4worldbusiness.com/login
# Buy-lead listing URLs to scrape (comma-separated). Filter to Georgia + your products.
GO4WORLD_LEAD_URLS=https://www.go4worldbusiness.com/buyers/georgia/ceramic-tiles.html,https://www.go4worldbusiness.com/buyers/georgia/bricks.html
# Set to false to watch the browser during setup/debugging.
GO4WORLD_HEADLESS=true
# Seconds between portal scrapes (3600 = hourly).
GO4WORLD_INTERVAL=3600
