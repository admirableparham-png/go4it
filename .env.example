# Copy this file to .env and fill in what you need.
#   cp .env.example .env

# --- Telegram alerts (optional but recommended) ---
# 1. Create a bot with @BotFather -> get the token.
# 2. Add the bot to your team group, send a message, then read the chat id
#    from  https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Matching sensitivity (0-100) ---
# A demand/offer pair scoring at or above this becomes a match. Lower = more
# (looser) matches, higher = only tight matches. 60 is a good starting point.
MATCH_THRESHOLD=60

# --- Database ---
# Default is a local SQLite file. Switch to Postgres later with one line:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/go4it
DATABASE_URL=sqlite:///data.db

# --- go4worldbusiness portal scraper (browser bot) ---
# Your OWN paid-account login. Leave blank to disable the portal source.
# WARNING: automated access may violate go4worldbusiness Terms and can risk your
# paid account. You chose this; keep the cadence gentle (hourly).
GO4WORLD_EMAIL=
GO4WORLD_PASSWORD=
GO4WORLD_LOGIN_URL=https://www.go4worldbusiness.com/login
# Buy-lead listing URLs to scrape (comma-separated). Filter to Georgia + your products.
GO4WORLD_LEAD_URLS=https://www.go4worldbusiness.com/buyers/georgia/ceramic-tiles.html,https://www.go4worldbusiness.com/buyers/georgia/bricks.html
# Set to false to watch the browser during setup/debugging.
GO4WORLD_HEADLESS=true
# Seconds between portal scrapes (3600 = hourly).
GO4WORLD_INTERVAL=3600
# The scraper is OFF unless this is exactly "true". go4worldbusiness blocks bots
# ("Too many requests") and auto-running it can flag your account — leave it off
# unless you have accepted that risk and it is actually working.
GO4WORLD_PORTAL_ENABLED=false

# --- Security (SET THESE FOR ANYTHING BEYOND localhost) ---
# Signs session cookies. If left as the default, an attacker can forge an admin session.
#   Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Key the in-browser capture helper uses to POST leads to /api/leads/raw.
GO4IT_INGEST_KEY=go4it-local-key
# Public base URL, used to build deep links in alerts/emails (set to your https URL in prod).
BASE_URL=http://localhost:8400

# --- Background auto-enrichment (optional) ---
# The worker (python -m app.worker, or the hourly launchd job) can auto-fill blank buyer emails/
# phones by scraping each new website-bearing lead's own site — no third-party credits. OFF by
# default. Set a positive interval (seconds) to enable; each lead is attempted once.
ENRICH_INTERVAL=0          # e.g. 3600 = hourly. 0 disables.
ENRICH_BATCH=40            # max leads scraped per pass (keep it polite)

# --- Outreach email (optional SMTP) ---
# Leave blank to use click-to-email (mailto) + click-to-WhatsApp only. Set these to send real
# email from inside go4it. Gmail: host smtp.gmail.com, port 587, pass = an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
